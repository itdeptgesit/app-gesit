# ===== GESIT PORTAL — Environment Variables =====
# Semua nilai VITE_* ter-bundle ke client JS (publik). JANGAN taruh secret di sini.

# Supabase (publik, aman untuk client)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google OAuth Client ID (publik, aman untuk client)
VITE_GOOGLE_CLIENT_ID=

# Google Apps Script endpoint untuk sync Excel (bisa di-rotate tanpa deploy)
VITE_GOOGLE_SHEETS_ENDPOINT=

# URL Base untuk Cetak QR Code Aset (default: https://it.gesit.co.id/asset)
VITE_ASSET_BASE_URL=https://it.gesit.co.id/asset

# ===== Supabase Edge Function Secrets (set di Dashboard Supabase → Edge Functions → Secrets) =====
# Jangan pernah set di env client / Vercel frontend.
# RESEND_API_KEY        → dipakai oleh edge function send-email & send-overdue-alert
# OPENROUTER_API_KEY    → dipakai oleh edge function ai-chat
# GDRIVE_SERVICE_ACCOUNT_JSON → dipakai oleh edge function upload-to-gdrive
# GDRIVE_FOLDER_ID      → root folder Google Drive CSL